# ============================================================
# MURUS Backend - Exemplo de configuração
# Copie para ".env" e ajuste:   cp .env.example .env
# O arquivo ".env" NUNCA deve ser versionado.
# ============================================================

# Ambiente: development | production | test
# Em "production" o API_TOKEN passa a ser OBRIGATÓRIO.
NODE_ENV=development

# Porta e interface de escuta.
# 0.0.0.0 = todas as interfaces (necessário para o celular alcançar o servidor).
# 127.0.0.1 = apenas a própria máquina.
PORT=3000
HOST=0.0.0.0

# Pasta onde as mídias são gravadas (organizadas em ANO/MÊS).
# Relativa ao diretório de execução, ou absoluta:
#   Windows (teste local): C:/murus-dados
#   Ubuntu (produção):     /mnt/murus/galeria
STORAGE_PATH=./storage

# Proteção contra gravar no disco errado caso o cartão SD não esteja montado.
# Em produção use true e crie o arquivo marcador uma vez, com o SD montado:
#   touch /mnt/murus/galeria/.murus-storage
REQUIRE_STORAGE_MARKER=false

# Tamanho máximo por arquivo, em MB.
MAX_FILE_SIZE_MB=2048

# Token de acesso (Authorization: Bearer <token>), mínimo 32 caracteres.
# Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Deixe vazio apenas em desenvolvimento local.
API_TOKEN=

# Limite de requisições por minuto, por IP.
RATE_LIMIT_PER_MINUTE=300

# Origens CORS permitidas (separadas por vírgula). Vazio = CORS desligado.
# O app móvel nativo NÃO precisa de CORS; use só para um cliente web.
CORS_ORIGINS=
